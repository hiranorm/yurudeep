---
// リボン付きのメダル（フラットなSVG）。Kaggleページで使う。
import type { Medal } from "../data/kaggle";

interface Props {
	medal: Medal;
	/** 表示幅(px)。高さは比率から決まる */
	width?: number;
	/** 円の中に「金/銀/銅」を書くか */
	label?: boolean;
	class?: string;
}

const { medal, width = 40, label = true, class: className } = Astro.props;

const palette: Record<
	Medal,
	{ rim: string; face: string; text: string; name: string }
> = {
	gold: { rim: "#b8860b", face: "#f2c94c", text: "#6b4e00", name: "金" },
	silver: { rim: "#8a94a3", face: "#d6dce4", text: "#3b4250", name: "銀" },
	bronze: { rim: "#94562a", face: "#d8975c", text: "#4a2a0e", name: "銅" },
};
const c = palette[medal];
---
<svg
    viewBox="0 0 40 54"
    width={width}
    height={(width * 54) / 40}
    class={className}
    role="img"
    aria-label={`${c.name}メダル`}
>
    <title>{c.name}メダル</title>
    <!-- リボン（右→左の順に描いて左を手前に） -->
    <polygon points="34,0 24,0 16,23 26,23" fill="#1c6ea4" />
    <polygon points="6,0 16,0 24,23 14,23" fill="#2b8fd0" />
    <line x1="11" y1="0" x2="19" y2="23" stroke="#fff" stroke-opacity="0.55" stroke-width="1.6" />
    <!-- メダル本体 -->
    <circle cx="20" cy="38" r="15" fill={c.rim} />
    <circle cx="20" cy="38" r="12.2" fill={c.face} />
    <circle cx="20" cy="38" r="10.2" fill="none" stroke={c.rim} stroke-opacity="0.45" stroke-width="0.8" />
    {label && (
        <text
            x="20"
            y="38"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="10.5"
            font-weight="700"
            fill={c.text}
        >{c.name}</text>
    )}
</svg>
