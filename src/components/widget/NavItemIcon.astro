---
interface Props {
	src: string;
	bg?: string;
}

const { src, bg } = Astro.props;
---
<span
    class="w-6 h-6 shrink-0 rounded-[22%] overflow-hidden ring-1 ring-black/5"
    style={bg ? `background:${bg}` : undefined}
>
    <img src={src} alt="" width="24" height="24" loading="lazy" class:list={["w-full h-full object-contain", bg && "p-0.5"]} />
</span>
