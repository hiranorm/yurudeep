---
import { type CollectionEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";

interface Props {
	entry: CollectionEntry<"tobari">;
	lang: string;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);

const apps = [
	{
		name: "永遠の帳",
		subtitle: "Eternal Veil",
		url: "https://tobari-4qj.pages.dev/towa/",
	},
	{
		name: "深海の帳",
		subtitle: "Deep-sea Veil",
		url: "https://tobari-4qj.pages.dev/shinkai/",
	},
	{
		name: "幕開けの帳",
		subtitle: "Dawn Veil",
		url: "https://tobari-4qj.pages.dev/makuake/",
	},
	{
		name: "宵蛍の帳",
		subtitle: "Firefly Veil",
		url: "https://tobari-4qj.pages.dev/hotaru/",
	},
	{
		name: "花火の帳",
		subtitle: "Fireworks Veil",
		url: "https://tobari-4qj.pages.dev/hanabi/",
	},
	{
		name: "波紋の帳",
		subtitle: "Ripple Veil",
		url: "https://tobari-4qj.pages.dev/hamon/",
	},
];

const languages: { code: string; label: string; href: string }[] = [
	{ code: "ja", label: "日本語", href: "/tobari/" },
	{ code: "en", label: "English", href: "/tobari/en/" },
	{ code: "zh-CN", label: "中文", href: "/tobari/zh-CN/" },
	{ code: "ko", label: "한국어", href: "/tobari/ko/" },
	{ code: "es", label: "Español", href: "/tobari/es/" },
	{ code: "th", label: "ไทย", href: "/tobari/th/" },
	{ code: "vi", label: "Tiếng Việt", href: "/tobari/vi/" },
	{ code: "id", label: "Bahasa Indonesia", href: "/tobari/id/" },
];
---

<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
  <div class="card-base z-10 px-9 py-6 relative w-full">
    <Markdown class="mt-2">
      <Content />
    </Markdown>

    <div class="tobari-apps mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
      {apps.map((app) => (
        <a
          href={app.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-5 rounded-xl border border-current/15 hover:border-[oklch(0.6_0.12_250)] hover:bg-[oklch(0.5_0.05_250_/0.08)] transition-all text-center group"
        >
          <div class="font-bold text-base group-hover:text-[oklch(0.7_0.15_250)] transition-colors">
            {app.name}
          </div>
          <div class="text-xs opacity-50 mt-1">{app.subtitle}</div>
        </a>
      ))}
    </div>

    <nav class="tobari-langs mt-10 pt-4 border-t border-current/10 text-xs opacity-60 flex flex-wrap gap-x-3 gap-y-1 justify-center">
      {languages.map((l, i) => (
        <>
          {i > 0 && <span class="opacity-40">|</span>}
          {l.code === lang ? (
            <span class="font-bold opacity-90">{l.label}</span>
          ) : (
            <a href={l.href} class="hover:opacity-100 hover:underline transition-opacity">{l.label}</a>
          )}
        </>
      ))}
    </nav>
  </div>
</div>
