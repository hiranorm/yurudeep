---
import { type CollectionEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";

interface Props {
	entry: CollectionEntry<"souten">;
	lang: string;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);

const apps = [
	{
		name: "souten",
		subtitle: "思考の発射装置",
		url: "https://souten.hira-euclid-norm-root2.workers.dev/",
	},
];

const languages: { code: string; label: string; href: string }[] = [
	{ code: "ja", label: "日本語", href: "/souten/" },
	{ code: "en", label: "English", href: "/souten/en/" },
];
---

<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
  <div class="card-base z-10 px-9 py-6 relative w-full">
    <Markdown class="mt-2">
      <Content />
    </Markdown>

    <div class="souten-apps mt-8 grid grid-cols-1 gap-3 max-w-md mx-auto">
      {apps.map((app) => (
        <a
          href={app.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-5 rounded-xl border border-current/15 hover:border-[oklch(0.65_0.2_310)] hover:bg-[oklch(0.5_0.1_310_/0.08)] transition-all text-center group"
        >
          <div class="font-bold text-base group-hover:text-[oklch(0.7_0.2_310)] transition-colors">
            {app.name}
          </div>
          <div class="text-xs opacity-50 mt-1">{app.subtitle}</div>
        </a>
      ))}
    </div>

    <nav class="souten-langs mt-10 pt-4 border-t border-current/10 text-xs opacity-60 flex flex-wrap gap-x-3 gap-y-1 justify-center">
      {languages.map((l, i) => (
        <>
          {i > 0 && <span class="opacity-40">|</span>}
          {l.code === lang ? (
            <span class="font-bold opacity-90">{l.label}</span>
          ) : (
            <a href={l.href} class="hover:opacity-100 hover:underline transition-opacity">{l.label}</a>
          )}
        </>
      ))}
    </nav>
  </div>
</div>
