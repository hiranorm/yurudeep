---
import { getEntry } from "astro:content";
import TanzakuPage from "@components/tanzaku/TanzakuPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const entry = await getEntry("tanzaku", "ja");

if (!entry) {
	throw new Error("tanzaku (ja) entry not found");
}
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang="ja">
  <TanzakuPage entry={entry} lang="ja" />
</MainGridLayout>
