---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { isExternalApp, appSections as sections } from "../../data/apps";
---

<MainGridLayout title="Apps" description="ひらノルムが作ったアプリ一覧">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<h1 class="text-3xl font-bold mb-2">Apps</h1>
			<p class="opacity-75 mb-8">ひらノルムが作った、ささやかなアプリ。</p>

			{sections.map((section) => (
				<section class="mb-10 last:mb-0">
					<h2 class="flex items-baseline gap-2 text-xl font-bold mb-4">
						{section.title}
						<span class="text-xs font-normal opacity-50">{section.note}</span>
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						{section.apps.map((app) => (
							<a
								href={app.href}
								target={isExternalApp(app) ? "_blank" : undefined}
								rel={isExternalApp(app) ? "noopener noreferrer" : undefined}
								class="block p-5 rounded-xl border border-current/15 hover:border-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition-all group"
							>
								<div class="flex items-center gap-4 mb-3">
									<div
										class="w-14 h-14 shrink-0 rounded-[22%] overflow-hidden shadow-sm ring-1 ring-black/5 group-hover:scale-105 transition-transform"
										style={app.iconBg ? `background:${app.iconBg}` : undefined}
									>
										<img
											src={app.icon}
											alt={`${app.name} のアイコン`}
											width="56"
											height="56"
											loading="lazy"
											class={`w-full h-full object-contain ${app.iconBg ? "p-2" : ""}`}
										/>
									</div>
									<div class="min-w-0">
										<div class="font-bold text-lg group-hover:text-[var(--primary)] transition-colors">
											{app.name}
										</div>
										<div class="text-sm opacity-70">{app.tagline}</div>
									</div>
								</div>
								<div class="text-xs opacity-60 leading-relaxed">{app.description}</div>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</div>
</MainGridLayout>
