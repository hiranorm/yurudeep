---
import MainGridLayout from "@layouts/MainGridLayout.astro";

type App = {
	name: string;
	href: string;
	icon: string;
	/** 透過アイコンの下に敷く背景色（不透明アイコンなら不要） */
	iconBg?: string;
	tagline: string;
	description: string;
};

const webApps: App[] = [
	{
		name: "tobari",
		href: "/tobari/",
		icon: "/blogimg/apps/tobari.svg",
		tagline: "視界に、帳を下ろす。",
		description:
			"作業中・GPU処理中・深夜作業中に視界と情報を遮断する超軽量Webアプリ群。",
	},
	{
		name: "souten",
		href: "/souten/",
		icon: "/blogimg/apps/souten.svg",
		iconBg: "#1f2433",
		tagline: "思考を、撃ち溜める。",
		description:
			"会議中・授業中に湧く「調べたい欲」を一時バッファし、検索エンジンやAIへ一斉発射するクライアント完結Webアプリ。",
	},
	{
		name: "ema",
		href: "/ema/",
		icon: "/blogimg/apps/ema.webp",
		tagline: "願いを、現実に、結ぶ。",
		description:
			"願いをQRコードにして机に貼り、行動するたびにスキャンする。参拝の回数が、行動の回数になるデジタル絵馬。",
	},
];

const mobileApps: App[] = [
	{
		name: "tanzaku",
		href: "/tanzaku/",
		icon: "/blogimg/apps/tanzaku.webp",
		tagline: "日本語を、縦に読もう。",
		description:
			"青空文庫・なろう・カクヨム等を縦書きで読めるAndroidブラウザアプリ。横書きサイトを本のような縦組みに自動変換する。",
	},
	{
		name: "chigusa",
		href: "/chigusa/",
		icon: "/blogimg/apps/chigusa.webp",
		tagline: "アイデアの種を、0 秒で土に埋める。",
		description:
			"思いついた瞬間に保存先を考えなくていいメモアプリ。タイトル・フォルダ・タグ不要で、あとから全文検索で掘り起こせるAndroidアプリ。",
	},
	{
		name: "sekimori",
		href: "/sekimori/",
		icon: "/blogimg/apps/sekimori.webp",
		tagline: "「必要なこと」より先に、本当にやりたいことを通す。",
		description:
			"朝いちばんに必ず通る動線=目覚ましを、やりたいことの第一関門にするAndroidアプリ。止めた瞬間にカウントが始まり、時間ぶん向き合ってはじめて手形が押せる。",
	},
];

const sections = [
	{ title: "スマホアプリ", note: "Android", apps: mobileApps },
	{ title: "Webアプリ", note: "ブラウザで動く", apps: webApps },
];
---

<MainGridLayout title="Apps" description="ひらノルムが作ったアプリ一覧">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<h1 class="text-3xl font-bold mb-2">Apps</h1>
			<p class="opacity-75 mb-8">ひらノルムが作った、ささやかなアプリ。</p>

			{sections.map((section) => (
				<section class="mb-10 last:mb-0">
					<h2 class="flex items-baseline gap-2 text-xl font-bold mb-4">
						{section.title}
						<span class="text-xs font-normal opacity-50">{section.note}</span>
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						{section.apps.map((app) => (
							<a
								href={app.href}
								class="block p-5 rounded-xl border border-current/15 hover:border-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition-all group"
							>
								<div class="flex items-center gap-4 mb-3">
									<div
										class="w-14 h-14 shrink-0 rounded-[22%] overflow-hidden shadow-sm ring-1 ring-black/5 group-hover:scale-105 transition-transform"
										style={app.iconBg ? `background:${app.iconBg}` : undefined}
									>
										<img
											src={app.icon}
											alt={`${app.name} のアイコン`}
											width="56"
											height="56"
											loading="lazy"
											class={`w-full h-full object-contain ${app.iconBg ? "p-2" : ""}`}
										/>
									</div>
									<div class="min-w-0">
										<div class="font-bold text-lg group-hover:text-[var(--primary)] transition-colors">
											{app.name}
										</div>
										<div class="text-sm opacity-70">{app.tagline}</div>
									</div>
								</div>
								<div class="text-xs opacity-60 leading-relaxed">{app.description}</div>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</div>
</MainGridLayout>
