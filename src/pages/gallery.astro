---
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { imageMetadata } from "astro/assets/utils";

const postsByImage = new Map<string, { title: string; url: string }[]>();
for (const post of await getSortedPostsList()) {
	const posts = postsByImage.get(post.data.image) ?? [];
	posts.push({ title: post.data.title, url: getPostUrlBySlug(post.slug) });
	postsByImage.set(post.data.image, posts);
}

// 画像に埋め込んだ IPTC メタデータ（XMP）から生成モデル名を読む。
// 付与は blog_image_making/ai_label.py。モデル名が無い AI 生成画像は「AI生成」、XMP が無い画像は表示なし。
const unescapeXml = (text: string) =>
	text
		.replaceAll("&lt;", "<")
		.replaceAll("&gt;", ">")
		.replaceAll("&quot;", '"')
		.replaceAll("&amp;", "&");
function readAiModel(buf: Buffer): string | undefined {
	const xmp = buf.toString("utf8");
	const model = xmp.match(
		/<Iptc4xmpExt:AISystemUsed>([^<]+)<\/Iptc4xmpExt:AISystemUsed>/,
	)?.[1];
	if (model) return unescapeXml(model);
	if (xmp.includes("digitalsourcetype/trainedAlgorithmicMedia"))
		return "AI生成";
	return undefined;
}

const eyecatchDir = join(process.cwd(), "public/blogimg/eyecatch");
const images = await Promise.all(
	readdirSync(eyecatchDir)
		.filter((file) => file.endsWith(".webp"))
		.sort()
		.map(async (file) => {
			const buf = readFileSync(join(eyecatchDir, file));
			const { width, height } = await imageMetadata(buf, file);
			return {
				src: `/blogimg/eyecatch/${file}`,
				name: file.replace(/\.webp$/, "").replaceAll("_", " "),
				posts: postsByImage.get(`/blogimg/eyecatch/${file}`) ?? [],
				model: readAiModel(buf),
				width,
				height,
			};
		}),
);
---

<MainGridLayout title="Gallery" description="ゆるディープのアイキャッチ画像の一覧">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
        <h1 class="text-2xl font-bold text-90 mb-2">Gallery</h1>
        <p class="text-sm text-50 mb-2">記事のアイキャッチ画像の一覧（{images.length} 枚）。これから使う候補も含む。クリックで拡大でき、前後の画像や、その画像を使っている記事へ移動できる。</p>
        <p class="text-sm text-50 mb-6">
            画像は主に、2026年11月までは <a class="link text-[var(--primary)] font-medium" href="https://huggingface.co/black-forest-labs/FLUX.1-schnell" target="_blank" rel="noopener noreferrer">FLUX.1-schnell</a>、それ以降は <a class="link text-[var(--primary)] font-medium" href="https://huggingface.co/black-forest-labs/FLUX.2-klein-4B" target="_blank" rel="noopener noreferrer">FLUX.2 [klein] 4B</a> と <a class="link text-[var(--primary)] font-medium" href="https://huggingface.co/Tongyi-MAI/Z-Image-Turbo" target="_blank" rel="noopener noreferrer">Z-Image-Turbo</a> で生成している（いずれも Apache 2.0 ライセンスで商用利用可）。一部は ChatGPT Image 系列で生成。AI で生成した画像には、AI生成であることとモデル名を示すメタデータ（IPTC）を埋め込んでいる。
        </p>
        <div id="eyecatch-gallery" class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {images.map((image) => (
                <figure class="m-0">
                    <img
                        src={image.src}
                        alt={image.name}
                        data-eyecatch-posts={JSON.stringify(image.posts)}
                        data-eyecatch-model={image.model}
                        loading="lazy"
                        decoding="async"
                        width={image.width}
                        height={image.height}
                        class="w-full aspect-video object-cover rounded-lg cursor-zoom-in transition hover:opacity-80"
                    />
                    <figcaption class="mt-1 text-xs text-50">
                        <span class="block truncate">{image.name}</span>
                        {image.model && <span class="block truncate opacity-75">{image.model}</span>}
                    </figcaption>
                </figure>
            ))}
        </div>
    </div>
</MainGridLayout>
