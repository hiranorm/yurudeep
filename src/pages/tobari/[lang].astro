---
import TobariPage from "@components/tobari/TobariPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { type CollectionEntry, getCollection } from "astro:content";

export async function getStaticPaths() {
	const entries = await getCollection("tobari");
	return entries
		.filter((e) => e.id.replace(/\.md$/, "") !== "ja")
		.map((entry) => ({
			params: { lang: entry.id.replace(/\.md$/, "") },
			props: { entry },
		}));
}

interface Props {
	entry: CollectionEntry<"tobari">;
}

const { entry } = Astro.props;
const { lang } = Astro.params;
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang={lang}>
  <TobariPage entry={entry} lang={lang!} />
</MainGridLayout>
