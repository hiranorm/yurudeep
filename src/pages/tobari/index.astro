---
import TobariPage from "@components/tobari/TobariPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("tobari", "ja");

if (!entry) {
	throw new Error("tobari (ja) entry not found");
}
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang="ja">
  <TobariPage entry={entry} lang="ja" />
</MainGridLayout>
