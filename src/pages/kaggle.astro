---
import KaggleMedal from "@components/KaggleMedal.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import {
	kaggleCompetitions,
	kaggleProfileUrl,
	kaggleTier,
	type Medal,
} from "../data/kaggle";

const posts = await getSortedPostsList();
const postBySlug = new Map(posts.map((p) => [p.slug, p]));

const competitions = [...kaggleCompetitions]
	.sort((a, b) => b.deadline.localeCompare(a.deadline))
	.map((c) => {
		const post = c.retroSlug ? postBySlug.get(c.retroSlug) : undefined;
		if (c.retroSlug && !post) {
			throw new Error(
				`Kaggle: retroSlug "${c.retroSlug}" の記事が見つからない`,
			);
		}
		const [year, month] = c.deadline.split("-");
		return {
			...c,
			url: `https://www.kaggle.com/competitions/${c.slug}`,
			top: ((c.rank / c.teams) * 100).toFixed(1),
			period: `${year}年${Number(month)}月`,
			retro: post
				? { title: post.data.title, url: getPostUrlBySlug(post.slug) }
				: undefined,
		};
	});

const medalLabel: Record<Medal, string> = {
	gold: "金",
	silver: "銀",
	bronze: "銅",
};
const medalOrder: Medal[] = ["gold", "silver", "bronze"];
const medalCounts = medalOrder
	.map((m) => ({
		medal: m,
		count: kaggleCompetitions.filter((c) => c.medal === m).length,
	}))
	.filter((m) => m.count > 0);
---

<MainGridLayout title="Kaggle" description="ひらノルムのKaggleコンペ実績（メダル獲得分）と振り返り記事">
	<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full" data-kaggle>
		<h1 class="text-3xl font-bold mb-2">Kaggle</h1>
		<p class="opacity-75 mb-5">Kaggleのコンペでメダルを取ったもの。振り返り記事を書いたコンペは、記事へのリンクを付けている。</p>

		<div class="flex flex-wrap items-center gap-2 mb-8">
			<span class="px-3 py-1 rounded-full text-sm font-bold bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
				{kaggleTier}
			</span>
			{medalCounts.map((m) => (
				<button
					type="button"
					data-medal-filter={m.medal}
					aria-pressed="false"
					title={`${medalLabel[m.medal]}メダルだけ表示（もう一度押すと解除）`}
					class="flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold border border-current/15 hover:border-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] active:scale-95 transition aria-pressed:border-[var(--primary)] aria-pressed:bg-[var(--btn-regular-bg)] aria-pressed:text-[var(--primary)]"
				>
					<KaggleMedal medal={m.medal} width={12} label={false} />
					{medalLabel[m.medal]} {m.count}
				</button>
			))}
			<a
				href={kaggleProfileUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-1 px-3 py-1 rounded-full text-sm font-bold text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition"
			>
				Kaggleのプロフィール
				<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.7rem]" />
			</a>
		</div>

		<div class="flex flex-col gap-4">
			{competitions.map((c) => (
				<div class="flex flex-col p-5 rounded-xl border border-current/15" data-medal={c.medal}>
					<div class="flex items-start gap-4">
						<KaggleMedal medal={c.medal} width={40} class="shrink-0 -mt-1" />
						<div class="min-w-0">
							<a
								href={c.url}
								target="_blank"
								rel="noopener noreferrer"
								class="font-bold text-lg leading-snug hover:text-[var(--primary)] transition-colors"
							>
								{c.title}
								<Icon name="fa6-solid:arrow-up-right-from-square" class="inline text-[0.7rem] opacity-40 -translate-y-0.5 ml-0.5" />
							</a>
							<div class="flex flex-wrap gap-x-3 text-sm mt-1">
								<span class="whitespace-nowrap">
									<span class="font-bold">{c.rank}位</span>
									<span class="opacity-60"> / {c.teams.toLocaleString("ja-JP")}チーム（上位{c.top}%）</span>
								</span>
								<span class="whitespace-nowrap opacity-60">{c.period}終了</span>
							</div>
						</div>
					</div>
					<p class="text-sm opacity-70 leading-relaxed mt-3">{c.summary}</p>
					{c.retro && (
						<a
							href={c.retro.url}
							class="mt-auto pt-4 group flex items-start gap-2 text-sm"
						>
							<Icon name="material-symbols:edit-note-rounded" class="text-[1.25rem] shrink-0 text-[var(--primary)]" />
							<span class="min-w-0">
								<span class="block text-xs font-bold text-[var(--primary)]">振り返り記事</span>
								<span class="opacity-80 group-hover:text-[var(--primary)] group-hover:opacity-100 transition-colors">{c.retro.title}</span>
							</span>
						</a>
					)}
				</div>
			))}
		</div>
	</div>
</MainGridLayout>

<script>
// メダルの印を押すと、そのメダルのコンペだけに絞り込む。もう一度押すと解除。
// swup でページが差し替わっても効くよう、document に委譲する。
document.addEventListener("click", (e) => {
	const btn = (e.target as Element | null)?.closest<HTMLElement>(
		"[data-medal-filter]",
	);
	const root = btn?.closest("[data-kaggle]");
	if (!btn || !root) return;
	const medal = btn.dataset.medalFilter;
	const turningOn = btn.getAttribute("aria-pressed") !== "true";
	for (const b of root.querySelectorAll<HTMLElement>("[data-medal-filter]")) {
		b.setAttribute("aria-pressed", String(turningOn && b === btn));
	}
	for (const card of root.querySelectorAll<HTMLElement>("[data-medal]")) {
		card.classList.toggle("hidden", turningOn && card.dataset.medal !== medal);
	}
});
</script>
