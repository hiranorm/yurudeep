---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} description={description}>
<slot slot="head" name="head"></slot>

<!-- Navbar (identical to MainGridLayout) -->
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto">
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Main content — same outer structure as MainGridLayout for Swup compatibility -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Empty sidebar placeholder — must exist for Swup to restore sidebar on blog pages -->
            <div id="sidebar" class="hidden"></div>

            <main id="swup-container" class="transition-swup-fade col-span-2 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation">
                        <Footer></Footer>
                    </div>
                </div>
            </main>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- #toc must exist for Swup to work normally -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <div id="toc"></div>
    </div>
</div>
</Layout>
